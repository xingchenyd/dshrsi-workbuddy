{
  "name": "dshrsi-workbuddy",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "DSHRSI for WorkBuddy: native hooks, shared RSI engine, validation and rollback.",
  "license": "MIT",
  "homepage": "https://github.com/xingchenyd/dshrsi-workbuddy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingchenyd/dshrsi-workbuddy.git"
  },
  "bugs": "https://github.com/xingchenyd/dshrsi-workbuddy/issues",
  "scripts": {
    "test": "node scripts/workbuddy-test.mjs",
